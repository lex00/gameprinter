---
// The home page: the six paths. A Starlight page rather than an
// MDX file, as on plunge's site, so the build bundles no MDX module.
// src/components/Hero.astro draws the hero: the title as a neon sign and the
// two actions as tube buttons.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Landing from '../components/Landing.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = 'Make original games that play in your browser, and port mechanics from ROMs you own.';
---
<StarlightPage
	frontmatter={{
		title: 'Game Printer',
		description,
		template: 'splash',
		hero: {
			title: 'Game Printer',
			tagline: 'What do you want to do?',
			actions: [
				{ text: 'Start here', link: `${base}/install/#start-here` },
				{ text: 'Play the games', link: 'https://lex00.github.io/games/', attrs: { rel: 'noopener' } },
			],
		},
	}}
>
	<Landing />
</StarlightPage>
