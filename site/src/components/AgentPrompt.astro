---
// "Optional: hand this page to your coding agent": the page's `prompt:` front
// matter (which always ends with neverLine from src/prompts.ts), with a copy
// button. Shown under the title by PageTitle.astro.
const { entry } = Astro.locals.starlightRoute;
const prompt: string | undefined = entry.data.prompt;
---
{prompt && (
	<details class="gp-prompt not-content">
		<summary>Optional: hand this page to your coding agent</summary>
		<pre>{prompt}</pre>
		<button type="button" class="tube violet quiet small gp-prompt-copy" data-copy={prompt}>Copy prompt</button>
	</details>
)}

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.gp-prompt-copy')) {
		const label = button.textContent;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Copy failed; select the text';
			}
			setTimeout(() => (button.textContent = label), 2000);
		});
	}
</script>

<style>
	.gp-prompt {
		margin-top: 1rem;
		padding: 0.8rem 1.1rem;
		background: var(--gp-panel);
		border: 2px solid color-mix(in srgb, var(--violet) 70%, var(--bg));
		border-radius: 16px;
		font-size: 1rem;
	}
	summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	pre {
		margin: 0.75rem 0;
		white-space: pre-wrap;
		font-family: var(--sl-font-mono);
		font-size: 1rem;
		line-height: 1.55;
		color: var(--sl-color-gray-1);
	}
	button {
		display: inline-flex;
	}
</style>
