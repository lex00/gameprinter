---
// The site title: a small pink neon sign (the shared sheet's .sign) that
// links to the docs home.
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title sign" translate="no">Game Printer</a>

<style>
	.site-title {
		display: block;
		padding: 0.5rem 0.9rem;
		border-width: 2px;
		border-radius: 12px;
		font-size: 1.125rem;
		line-height: 1;
		letter-spacing: 0.08em;
		white-space: nowrap;
		overflow-wrap: normal;
		text-decoration: none;
		text-shadow: 0 0 6px #fff, 0 0 14px var(--pink);
		box-shadow: 0 0 10px var(--pink), inset 0 0 8px color-mix(in srgb, var(--pink) 40%, transparent);
		animation: none;
	}
	@media (min-width: 50rem) {
		.site-title {
			padding: 0.6rem 1.1rem;
			font-size: 1.375rem;
		}
	}
</style>
