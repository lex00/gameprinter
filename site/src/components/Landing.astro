---
// The home page under the hero: the six paths, making your own game first,
// each saying where it stands.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ways = [
	{ title: 'Make your own game', href: `${base}/make/`, text: 'Copy a small starter game and change how it plays. Early: it runs on your own computer for now.' },
	{ title: 'Play', href: 'https://lex00.github.io/games/', text: 'Play the published games in your browser.' },
	{ title: 'Themes and levels', href: `${base}/themes/`, text: 'Draw new pictures and sounds for a game, or lay out a new stage. Early: players can\'t pick a new stage yet.' },
	{ title: 'Host your game or theme', href: `${base}/host-your-own/`, text: 'Put it online on your own free Cloudflare account and share the link. Your AI agent can walk you through it.' },
	{ title: 'Bring in a game', href: `${base}/bring/`, text: 'Port a game\'s mechanics from a ROM you own. Early: NES games and Tapper\'s arcade board so far.' },
	{ title: 'Improve a game', href: `${base}/improve/`, text: 'Fix something in how a published game plays, and send the fix back.' },
];
const more = [
	{ title: 'Start here: install gp', href: `${base}/install/` },
	{ title: 'ROM rules', href: `${base}/rom-rules/` },
	{ title: 'Run a registry', href: `${base}/registry/` },
	{ title: 'Contribute to the tool', href: `${base}/contribute/` },
	{ title: 'gp commands', href: `${base}/reference/cli/` },
];
---
<div class="gp-landing not-content">
	<p class="gp-intro">Game Printer lets you create original games that run in your browser with nothing to install. It has powerful tools to help you port mechanics from your old ROMs and breathe new life into old games.</p>
	<p class="gp-intro">New here? <a href={`${base}/install/#start-here`}>Start here</a>: install <code>gp</code>, add the gp plugin to Claude Code, and port a game from your own ROM with <code>/gp:port</code>.</p>
	<ul class="gp-ways">
		{ways.map((w) => (
			<li>
				<a href={w.href}>
					<span class="gp-way-title">{w.title}</span>
					<span class="gp-way-text">{w.text}</span>
				</a>
			</li>
		))}
	</ul>
	<p class="gp-status">{more.map((m, i) => (<>{i > 0 && ' · '}<a href={m.href}>{m.title}</a></>))}</p>
</div>

<style>
	.gp-landing {
		display: grid;
		gap: 2rem;
		max-width: 64rem;
		margin: 0 auto;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}
	.gp-intro {
		max-width: 44rem;
		margin: 0 auto;
		font-size: var(--sl-text-base);
		color: var(--sl-color-gray-2);
	}
	.gp-ways {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.gp-ways a {
		display: grid;
		gap: 0.5rem;
		height: 100%;
		padding: 1.1rem 1.2rem;
		background: var(--gp-panel);
		border: 1px solid var(--gp-rule);
		border-radius: 0.6rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.gp-ways a:hover {
		border-color: var(--gp-cyan);
	}
	.gp-way-title {
		font-family: var(--gp-display);
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--sl-color-white);
	}
	.gp-status {
		margin: 0;
		text-align: center;
		color: var(--sl-color-gray-3);
	}
	.gp-status a {
		color: var(--gp-accent);
		text-decoration-color: color-mix(in srgb, var(--gp-accent) 35%, transparent);
	}
	.gp-status a:hover {
		text-decoration-color: var(--gp-cyan);
	}
</style>
