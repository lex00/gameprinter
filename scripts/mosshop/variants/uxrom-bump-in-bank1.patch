+    .byte %00100001     ; mapper 2 (UxROM), vertical mirroring
     .byte %00000000
     .byte 0, 0, 0, 0, 0, 0, 0, 0
 
@@ -450,6 +450,8 @@
     sta ON_GROUND
     jmp @checks
 @rising:
+    lda #1              ; a bumped head's code is in bank 1
+    sta bank_table+1
     jsr bump_head
 @in_air:
     lda #0
@@ -512,34 +514,6 @@
 @down:
     adc PLAYER_Y_HI
     sta PLAYER_Y_HI
-    rts
