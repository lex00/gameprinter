 ; A coin in the cell at the pickup point is taken: the cell becomes sky.
@@ -1201,8 +1175,43 @@
 @done:
     rts
 
+.segment "BANK1"
+
+; Rising: the cell at the head point decides. A solid cell ends the rise
+; where the player is; a ? block in it becomes a used block and gives a coin.
+bump_head:
+    lda PLAYER_X
+    clc
+    adc #HEAD_X
+    sta TMP_XL
+    lda PLAYER_X_HI
+    adc #0
+    sta TMP_XH
+    lda PLAYER_Y
+    sta TMP_Y
+    jsr cell_at
+    tax
+    lda metatile_solid,x
+    beq @done           ; open: the rise goes on
+    lda #0
+    sta PLAYER_VY
+    sta PLAYER_VYSUB
+    lda metatile_kind,x
+    cmp #KIND_COIN_BLOCK
+    bne @done
+    lda #USED_BLOCK
+    jsr set_cell
+    inc COINS
+@done:
+    rts
+
 .segment "RODATA"
 
+; Bank numbers at their own values, so a write to select one agrees with
+; the ROM byte it lands on (UxROM's bus conflicts).
+bank_table:
+    .byte 0, 1, 2, 3
+
 palette:
     ; background: sky, moss green, soil brown, tan
     .byte $21, $1A, $17, $37
