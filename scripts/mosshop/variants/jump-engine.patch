+; Jumps to the A'th word after the JSR that called it: the caller's return
+; address, pulled from the stack, is one less than the table.
+jump_engine:
+    asl a
+    tay
+    pla
+    sta TMP_PTR
+    pla
+    sta TMP_PTR+1
+    iny
+    lda (TMP_PTR),y
+    sta TMP_DST
+    iny
+    lda (TMP_PTR),y
+    sta TMP_DST+1
+    jmp (TMP_DST)
+
