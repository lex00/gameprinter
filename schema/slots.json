{
  "$id": "game-printer:slots@0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State",
  "description": "The state file: every slot's state, by slot name.",
  "type": "object",
  "properties": {
    "format": {
      "description": "The format version, 0.1.0.",
      "type": "string"
    },
    "model": {
      "description": "The model the slots are its.",
      "type": "string"
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SlotState"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "model"
  ],
  "$defs": {
    "Origin": {
      "description": "Where a slot's current files came from.",
      "oneOf": [
        {
          "description": "The source game, through the asset map.",
          "type": "string",
          "const": "source"
        },
        {
          "description": "Generated by `gp assets stub`.",
          "type": "string",
          "const": "stub"
        },
        {
          "description": "Made by a generator (a model or a tool).",
          "type": "string",
          "const": "generated"
        },
        {
          "description": "Supplied by a person.",
          "type": "string",
          "const": "uploaded"
        }
      ]
    },
    "SlotState": {
      "description": "One slot's state.",
      "type": "object",
      "properties": {
        "author": {
          "description": "Who made it.",
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "description": "The tool or model that made it.",
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "description": "An SPDX license expression, or `LicenseRef-own-copy` for an\noriginal extracted from the person's own copy.",
          "type": "string"
        },
        "note": {
          "description": "One line on what it is or why it was placed.",
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "sha256": {
          "description": "The SHA-256 of the slot's files, as `sha256sum` lines sorted by\nname and hashed again (the template manifest's `lifted_sha256`).",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "origin",
        "license",
        "sha256"
      ]
    },
    "Status": {
      "description": "What fills a slot now.",
      "oneOf": [
        {
          "description": "Lifted from the source.",
          "type": "string",
          "const": "original"
        },
        {
          "description": "A placeholder of the same shape (`gp assets stub`).",
          "type": "string",
          "const": "stub"
        },
        {
          "description": "Placed by `assets_place`.",
          "type": "string",
          "const": "replaced"
        }
      ]
    }
  }
}
