{
  "$id": "game-printer:theme-stack@0.1.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Printer theme stack 0.1.0",
  "description": "A stack: themes in order, bottom first.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string"
    },
    "layer": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Layer"
      }
    },
    "model": {
      "description": "The model it's for, by `model.name`.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "format"
  ],
  "$defs": {
    "Layer": {
      "description": "One layer of a stack.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "theme": {
          "description": "The theme's id, found in the template's `themes/` (baked) or the\nplayer's `$GP_HOME/themes/` (personal).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "theme",
        "scope"
      ]
    },
    "Scope": {
      "description": "Where a layer lives and who sees it.",
      "oneOf": [
        {
          "description": "Shipped with the template or fork as its default look.",
          "type": "string",
          "const": "baked"
        },
        {
          "description": "Only on this player's screen; never shipped.",
          "type": "string",
          "const": "personal"
        }
      ]
    }
  }
}
